{
  "_test": {
    "timeout_s": 900,
    "resource": "pw://alvaro/gcpsmall",
    "endpoint_name": "apptest",
    "leftover_patterns": [
      "pw endpoints run",
      "server.py 8090",
      "worker.py 127.0.0.1 8090"
    ]
  },
  "server": {
    "resource": "pw://alvaro/gcpsmall"
  },
  "services": {
    "deploy_server": true,
    "restart_server": false
  },
  "app": {
    "workdir": "~/app-testbed",
    "subdomain": "apptest",
    "server_port": 8090,
    "tunnel_method": "auto",
    "wait_for_workers": true
  },
  "workers": [
    {
      "resource": "pw://alvaro/gcpsmall",
      "worker_name": "",
      "workdir": "~/app-testbed-worker",
      "scheduler": false,
      "slurm": {
        "partition": "",
        "account": "",
        "qos": "",
        "cpus_per_task": 1,
        "time": "01:00:00",
        "scheduler_directives": ""
      },
      "pbs": {
        "account": "",
        "scheduler_directives": ""
      }
    }
  ]
}
