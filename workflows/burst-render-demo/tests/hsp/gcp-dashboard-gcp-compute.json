{
  "_test": {
    "timeout_s": 1800,
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "warm_marker": "${HOME}/pw/software/burst-render-demo/venv/bin/python",
    "leftover_patterns": [
      "uvicorn dashboard:app",
      "pw endpoints run",
      "dispatch_renders.sh",
      "render_tiles.sh",
      "renderer.py"
    ]
  },
  "head": {
    "resource": "pw://alvaro/gcpsmall"
  },
  "targets": [
    {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": true,
      "slurm": {
        "partition": "compute",
        "nodes": "1",
        "time": "",
        "scheduler_directives": "##SBATCH --constraint=mla # uncomment for Navy and AFRL DSRC systems\n",
        "account": "",
        "qos": ""
      }
    }
  ],
  "render_settings": {
    "grid_size": "4",
    "image_size": "128",
    "palette": "fire",
    "parallelism": "auto"
  }
}
