{
  "_test": {
    "timeout_s": 3600,
    "endpoint": false,
    "warm_marker": [
      "${HOME}/pw/software/dakota-openfoam/miniforge/envs/openfoam",
      "${HOME}/pw/software/dakota-openfoam/miniforge/envs/dakota"
    ],
    "leftover_patterns": ["bin/dakota", "app/driver.py", "simpleFoam", "blockMesh"]
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "01:00:00",
      "scheduler_directives": ""
    }
  },
  "optimizer": {
    "max_iterations": 3,
    "batch_size": 4,
    "stall_generations": 3,
    "mesh_scale": 1
  }
}
