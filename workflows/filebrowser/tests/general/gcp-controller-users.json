{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/filebrowser/database/filebrowser.db",
    "leftover_patterns": [
      "filebrowser",
      "docker compose",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "docker_containers": "(docker ps -aq --filter name=filebrowser 2>/dev/null || sudo -n docker ps -aq --filter name=filebrowser 2>/dev/null || echo ERR) | wc -l"
    }
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": false
  },
  "service": {
    "data_dir": "${HOME}",
    "rundir": "${HOME}/filebrowser",
    "auth_method": "json",
    "admin_password": "workflow-test-password-not-a-secret"
  }
}
