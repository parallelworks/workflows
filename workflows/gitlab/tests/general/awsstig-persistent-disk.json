{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "/disk/gitlab-alvaro/data/postgresql/data",
    "leftover_patterns": [
      "assets/init-rootless",
      "runsvdir -P /opt/gitlab/service",
      "gitlab-runner run",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "instances": "grep -l /disk/gitlab-alvaro/data /proc/[0-9]*/mountinfo 2>/dev/null | wc -l"
    }
  },
  "resource": "pw://alvaro/awsstig",
  "mode": "gitlab",
  "service": {
    "container_runtime": "gitlab-singularity",
    "subdomain": "gitlab-alvaro-test2",
    "rundir": "/disk/gitlab-alvaro",
    "ssh_port": 2223
  },
  "runners": {
    "shell": true,
    "slurm": true
  },
  "oidc": {}
}
