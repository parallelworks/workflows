{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "${HOME}/gitlab-test/data/postgresql/data",
    "leftover_patterns": [
      "assets/init-container",
      "runsvdir -P /opt/gitlab/service",
      "gitlab-runner run",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "instances": "grep -l $HOME/gitlab-test/data /proc/[0-9]*/mountinfo 2>/dev/null | wc -l"
    }
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "partition": "compute",
      "time": "03:00:00"
    }
  },
  "service": {
    "container_runtime": "gitlab-singularity",
    "subdomain": "gitlab-alvaro-test",
    "rundir": "${HOME}/gitlab-test",
    "ssh_port": 2223
  },
  "runners": {
    "shell": true,
    "slurm": true,
    "demo_project": true
  },
  "oidc": {}
}
