{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "${HOME}/gitlab-test-image/state/data.img",
    "leftover_patterns": [
      "assets/init-container",
      "runsvdir -P /opt/gitlab/service",
      "gitlab-runner run",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "instances": "pgrep -fc '[g]itlab-test-image/state/' || true"
    }
  },
  "resource": "pw://alvaro/gcpsmall",
  "service": {
    "container_runtime": "gitlab-singularity",
    "subdomain": "gitlab-alvaro-test",
    "rundir": "${HOME}/gitlab-test-image",
    "ssh_port": 2224,
    "state_layout": "image",
    "state_image_size": 6
  },
  "runners": {
    "shell": true,
    "slurm": true
  },
  "oidc": {}
}
