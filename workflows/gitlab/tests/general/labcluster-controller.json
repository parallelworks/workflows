{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "${HOME}/gitlab-test/data/postgresql/data",
    "leftover_patterns": [
      "docker logs -f gitlab_",
      "gitlab-runner run",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "containers": "sudo docker ps -aq --filter name=gitlab_ | wc -l"
    }
  },
  "resource": "pw://labcluster",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "subdomain": "gitlab-alvaro-test",
    "rundir": "${HOME}/gitlab-test"
  },
  "runners": {
    "shell": true,
    "slurm": false,
    "demo_project": true
  },
  "oidc": {}
}
