{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "${HOME}/gitlab-dev/data/postgresql/data",
    "leftover_patterns": [
      "docker logs -f gitlab_",
      "gitlab-runner run",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "containers": "sudo -n docker ps -aq --filter label=activate.rundir=$HOME/gitlab-dev | wc -l"
    }
  },
  "resource": "pw://labcluster",
  "service": {
    "container_runtime": "gitlab-docker",
    "subdomain": "gitlab-alvaro",
    "rundir": "${HOME}/gitlab-dev"
  },
  "runners": {
    "shell": true,
    "slurm": false
  },
  "oidc": {}
}
