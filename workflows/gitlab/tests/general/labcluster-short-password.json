{
  "_test": {
    "timeout_s": 600,
    "expect": "error",
    "endpoint": false,
    "leftover_patterns": [
      "docker logs -f gitlab_",
      "gitlab-runner run",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "containers": "sudo -n docker ps -aq --filter label=activate.rundir=$HOME/gitlab-test | wc -l"
    }
  },
  "resource": "pw://labcluster",
  "service": {
    "container_runtime": "gitlab-docker",
    "subdomain": "gitlab-alvaro-test",
    "rundir": "${HOME}/gitlab-test",
    "ssh_port": 2223,
    "root_password": "short"
  },
  "runners": {
    "shell": true,
    "slurm": false
  },
  "oidc": {}
}
