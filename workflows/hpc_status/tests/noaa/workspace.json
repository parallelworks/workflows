{
  "_test": {
    "timeout_s": 1500,
    "warm_marker": "${HOME}/pw/software/hpc_status/venv/bin/python",
    "leftover_patterns": [
      "pw endpoints run",
      "src.server.main"
    ],
    "endpoint_name": "rdhpcs-status"
  },
  "platform": "noaa",
  "cluster": {
    "resource": "workspace"
  },
  "service": {
    "cluster_monitor_interval": 180,
    "enable_cluster_monitor": true,
    "enable_cluster_pages": true,
    "name": "",
    "subdomain": "",
    "sweep_concurrency": 6,
    "theme": "light"
  }
}
