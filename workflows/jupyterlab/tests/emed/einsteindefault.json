{
  "_test": {
    "timeout_s": 900,
    "leftover_patterns": [
      "jupyter-lab",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "squeue_hpc4": "squeue -M hpc4 -h -u $USER | grep -v '^CLUSTER' | wc -l"
    }
  },
  "cluster": {
    "resource": "pw://avidaltorr/einsteindefault",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "slurm_options": "hpc4",
      "partition_hpc4": "test",
      "cpus_per_task": 1,
      "mem": "8GB",
      "time": "00:30:00",
      "scheduler_directives": "--exclude=cpu-811"
    }
  },
  "service": {}
}
