{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": "${HOME}/pw/software/miniconda3c",
    "leftover_patterns": ["jupyter", "pw endpoints run"]
  },
  "resource": "jean",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "notebook_dir": "${HOME}",
    "conda_install": true,
    "parent_install_dir": "${HOME}/pw/software",
    "conda_install_dir": "miniconda3c",
    "conda_env": "base",
    "install_instructions": "jupyterlab4.1.5-python3.11.5"
  }
}
