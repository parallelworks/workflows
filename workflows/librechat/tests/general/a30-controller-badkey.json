{
  "_test": {
    "expect": "error",
    "endpoint": false,
    "timeout_s": 900,
    "warm_marker": "${HOME}/pw/software/containers/librechat",
    "leftover_patterns": [
      "librechat",
      "mongod",
      "meilisearch",
      "pw endpoints run"
    ]
  },
  "resource": "pw://alvaro/a30gpuserver",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "librechat_dir": "${HOME}/pw/LibreChat",
    "domain_client": "ACTIVATE"
  },
  "env_vars": {
    "ACTIVATE_API_KEY": "not-a-real-key"
  }
}
