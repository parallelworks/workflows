{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/pw/software/containers/librechat",
    "leftover_patterns": [
      "librechat",
      "mongod",
      "meilisearch",
      "pw endpoints run"
    ],
    "secret_files": { "~/.config/pw/api-key": "ACTIVATE_API_KEY" }
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "librechat_dir": "${HOME}/pw/LibreChat",
    "domain_client": "ACTIVATE"
  }
}
