{
  "_test": {
    "timeout_s": 1200,
    "expect": "error",
    "endpoint": false,
    "warm_marker": [
      "${HOME}/pw/software/containers/vllm.sif"
    ],
    "leftover_patterns": [
      "vllm.entrypoints",
      "pw endpoints"
    ]
  },
  "resource": "pw://alvaro/a30gpuserver",
  "engine": "vllm",
  "cluster": {
    "scheduler": false
  },
  "model": {
    "source": "huggingface",
    "hf_model_id": "parallelworks/no-such-model-llm-server-test",
    "cache_dir": "~/pw/models"
  },
  "vllm": {
    "num_gpus": "1",
    "gpu_memory": "0.70",
    "max_model_len": "4096",
    "dtype": "float16",
    "attention_backend": "TRITON_ATTN",
    "extra_args": "--trust_remote_code",
    "container_uri": "ghcr.io/parallelworks/vllm:v1.0"
  },
  "service": {
    "parent_install_dir": "${HOME}/pw/software"
  }
}
