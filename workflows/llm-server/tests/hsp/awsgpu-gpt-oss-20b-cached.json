{
  "_test": {
    "timeout_s": 5400,
    "warm_marker": [
      "${HOME}/pw/software/containers/vllm.sif",
      "${HOME}/pw/models/gpt-oss-20b/config.json"
    ],
    "leftover_patterns": [
      "vllm.entrypoints",
      "pw endpoints"
    ]
  },
  "resource": "pw://alvaro/awsgpu",
  "engine": "vllm",
  "cluster": {
    "scheduler": false
  },
  "model": {
    "source": "cached_model",
    "cached_model_id": "openai/gpt-oss-20b",
    "cache_dir": "~/pw/models"
  },
  "vllm": {
    "num_gpus": "1",
    "gpu_memory": "0.90",
    "max_model_len": "auto",
    "dtype": "bfloat16",
    "attention_backend": "TRITON_ATTN",
    "extra_args": "--trust_remote_code --async-scheduling --enable-auto-tool-choice --tool-call-parser openai"
  },
  "service": {
    "parent_install_dir": "${HOME}/pw/software"
  }
}
