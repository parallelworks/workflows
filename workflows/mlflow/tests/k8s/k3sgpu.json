{
  "_test": {
    "timeout_s": 1200
  },
  "k8s": {
    "cluster": "k3sgpu",
    "namespace": "alvarok8s",
    "volumes": {
      "pvc": "New",
      "pvc_mount_path": "/mnt",
      "pvc_storage_size": "1Gi",
      "pvc_persist": false
    },
    "resources": {
      "requests": {
        "memory": "1Gi",
        "cpu": "1"
      },
      "limits": {
        "memory": "2Gi",
        "cpu": "2",
        "select_gpu": "None"
      }
    }
  },
  "service_k8s": {
    "image": "ghcr.io/mlflow/mlflow:v3.17.0",
    "image_port": 5000,
    "workers": 2,
    "job_execution": false
  }
}
