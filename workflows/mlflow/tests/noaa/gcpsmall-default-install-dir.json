{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/pw/software/.miniforge3-mlflow/bin/mlflow",
    "leftover_patterns": [
      "mlflow",
      "pw endpoints run"
    ]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "backend_store_uri": "sqlite:///${HOME}/mlflow/mlflow.db",
    "artifacts_destination": "${HOME}/mlflow/artifacts",
    "conda_install": true,
    "conda_install_dir": ".miniforge3-mlflow",
    "conda_env": "base",
    "install_instructions_tag_cloud": "mlflow3.16.1-python3.14.7",
    "job_execution": false
  }
}
