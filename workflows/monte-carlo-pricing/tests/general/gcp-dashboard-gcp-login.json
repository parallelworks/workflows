{
  "_test": {
    "timeout_s": 1200,
    "resource": "pw://alvaro/gcpsmall",
    "warm_marker": "${HOME}/pw/software/monte-carlo-pricing/venv/bin/python",
    "leftover_patterns": [
      "uvicorn dashboard:app",
      "pw endpoints run",
      "dispatch_simulations.sh",
      "run_simulation.sh",
      "simulator.py"
    ]
  },
  "head": {
    "resource": "pw://alvaro/gcpsmall"
  },
  "targets": [
    {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": false
    }
  ],
  "simulation_settings": {
    "option_type": "asian_call",
    "total_simulations": "100000",
    "batch_size": "10000",
    "parallelism": "4"
  }
}
