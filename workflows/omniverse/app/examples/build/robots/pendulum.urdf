<?xml version="1.0"?>
<!-- A two-link pendulum on a post: revolute joints, boxes and cylinders, no mesh files -->
<robot name="pendulum">
  <link name="base">
    <visual><geometry><box size="0.3 0.3 0.05"/></geometry><origin xyz="0 0 0.025"/></visual>
    <collision><geometry><box size="0.3 0.3 0.05"/></geometry><origin xyz="0 0 0.025"/></collision>
    <inertial><mass value="5"/><inertia ixx="0.04" iyy="0.04" izz="0.07" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="post">
    <visual><geometry><cylinder radius="0.03" length="1.0"/></geometry><origin xyz="0 0 0.5"/></visual>
    <collision><geometry><cylinder radius="0.03" length="1.0"/></geometry><origin xyz="0 0 0.5"/></collision>
    <inertial><mass value="2"/><origin xyz="0 0 0.5"/><inertia ixx="0.17" iyy="0.17" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="base_to_post" type="fixed">
    <parent link="base"/><child link="post"/><origin xyz="0 0 0.05"/>
  </joint>
  <link name="upper">
    <visual><geometry><box size="0.05 0.05 0.5"/></geometry><origin xyz="0 0 -0.25"/></visual>
    <collision><geometry><box size="0.05 0.05 0.5"/></geometry><origin xyz="0 0 -0.25"/></collision>
    <inertial><mass value="1"/><origin xyz="0 0 -0.25"/><inertia ixx="0.021" iyy="0.021" izz="0.0004" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="post"/><child link="upper"/><origin xyz="0 0.06 1.0" rpy="1.2 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="10" velocity="10"/><dynamics damping="0.05"/>
  </joint>
  <link name="lower">
    <visual><geometry><box size="0.04 0.04 0.4"/></geometry><origin xyz="0 0 -0.2"/></visual>
    <collision><geometry><box size="0.04 0.04 0.4"/></geometry><origin xyz="0 0 -0.2"/></collision>
    <inertial><mass value="0.5"/><origin xyz="0 0 -0.2"/><inertia ixx="0.0067" iyy="0.0067" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="lower"/><origin xyz="0 0.05 -0.5" rpy="0.6 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="10" velocity="10"/><dynamics damping="0.05"/>
  </joint>
</robot>
