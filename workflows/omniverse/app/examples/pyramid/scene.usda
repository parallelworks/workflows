            token outputs:displacement.connect = </World/Materials/color_5/Shader.outputs:displacement>
            token outputs:surface.connect = </World/Materials/color_5/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float3 inputs:diffuseColor = (0.95, 0.85, 0.3)
                float inputs:roughness = 0.4
                token outputs:displacement
                token outputs:surface
            }
        }

        def Material "ball"
        {
            token outputs:displacement.connect = </World/Materials/ball/Shader.outputs:displacement>
            token outputs:surface.connect = </World/Materials/ball/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float3 inputs:diffuseColor = (0.92, 0.92, 0.95)
                float inputs:metallic = 1
                float inputs:roughness = 0.15
                token outputs:displacement
                token outputs:surface
            }
        }
    }

