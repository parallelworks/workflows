{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": [
      "${HOME}/pw/software/omniverse/containers/isaac-sim-6.2.0.1.sif",
      "${HOME}/pw/software/omniverse/cache/.cache/ov"
    ],
    "leftover_patterns": [
      "build.py --manifest"
    ],
    "endpoint": false
  },
  "resource": "pw://alvaro/awsgpu",
  "cluster": {
    "scheduler": true,
    "cpus": 8,
    "gpus": 0,
    "slurm": {
      "is_enabled": true,
      "partition": "gpu",
      "time": "01:00:00"
    }
  },
  "files": {
    "destination": "/home/alvaro/omniverse-builds"
  },
  "software": {
    "runtime": "omniverse-singularity"
  }
}
