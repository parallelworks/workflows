{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": [
      "${HOME}/pw/software/omniverse/containers/isaac-sim-6.2.0.1.sif",
      "${HOME}/pw/software/omniverse/blast/blast-fracture"
    ],
    "setup": "mkdir -p ${HOME}/omniverse-test && printf 'v -1 -0.1 0\\nv 1 -0.1 0\\nv 1 0.1 0\\nv -1 0.1 0\\nv -1 -0.1 1.2\\nv 1 -0.1 1.2\\nv 1 0.1 1.2\\nv -1 0.1 1.2\\nf 1 4 3 2\\nf 5 6 7 8\\nf 1 2 6 5\\nf 2 3 7 6\\nf 3 4 8 7\\nf 4 1 5 8\\n' > ${HOME}/omniverse-test/wall.obj",
    "leftover_patterns": [
      "serve.py --port",
      "run.py --out",
      "pw endpoints run"
    ]
  },
  "resource": "pw://alvaro/awsgpu",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "example": "fracture",
    "frames": 60,
    "resolution": "1280x720",
    "renderer": "RayTracedLighting"
  },
  "fracture": {
    "own_mesh": true,
    "cells": 16,
    "seed": 3,
    "strength": 150000
  },
  "files": {
    "use_bucket": false,
    "source": "/home/alvaro/omniverse-test"
  },
  "software": {
    "runtime": "omniverse-singularity"
  }
}
