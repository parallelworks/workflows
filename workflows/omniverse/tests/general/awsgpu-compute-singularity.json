{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": [
      "${HOME}/pw/software/omniverse/containers/isaac-sim-6.2.0.1.sif",
      "${HOME}/pw/software/omniverse/cache/.cache/ov"
    ],
    "leftover_patterns": [
      "serve.py --port",
      "render.py --out",
      "pw endpoints run"
    ]
  },
  "resource": "pw://alvaro/awsgpu",
  "cluster": {
    "scheduler": true,
    "gpus": 1,
    "slurm": {
      "is_enabled": true,
      "partition": "gpu",
      "time": "01:00:00"
    }
  },
  "service": {
    "accept_eula": true,
    "frames": 60,
    "resolution": "1280x720",
    "renderer": "RayTracedLighting"
  },
  "software": {
    "runtime": "singularity"
  }
}
