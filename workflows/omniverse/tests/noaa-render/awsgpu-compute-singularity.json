{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": [
      "${HOME}/pw/software/omniverse/containers/isaac-sim-6.2.0.1.sif",
      "${HOME}/pw/software/omniverse/cache/.cache/ov"
    ],
    "leftover_patterns": [
      "serve.py --port",
      "run.py --out",
      "pw endpoints run"
    ]
  },
  "resource": "pw://alvaro/awsgpu",
  "cluster": {
    "scheduler": true,
    "cpus": 8,
    "gpus": 0,
    "slurm": {
      "is_enabled": true,
      "partition": "gpu",
      "time": "01:00:00"
    }
  },
  "service": {
    "example": "physics",
    "frames": 60,
    "snapshots": 30
  },
  "software": {
    "runtime": "omniverse-singularity"
  }
}
