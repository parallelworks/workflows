FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|stepInlet)"
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    "(lowerWall|stepWall|upperWall)"
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

