FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// NB: values set by simulator.sh: endTime, and the lossIn block is removed
// when the mesh has no lossIn faceZone (Gartling placement, inlet at step).
application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         8000;
deltaT          1;
writeControl    timeStep;
writeInterval   4000;
purgeWrite      1;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    totalPressureField
    {
        // p + 0.5*|U|^2 (kinematic, rho = 1) -> field "total(p)"
        type            pressure;
        libs            ("libfieldFunctionObjects.so");
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
        writeFields     false;
        log             false;
        mode            total;
        rho             rhoInf;
        rhoInf          1;
    }

    //BEGIN lossIn
    lossInZone
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        regionType      faceZone;
        name            lossIn;
        operation       weightedAverage;
        weightField     phi;
        fields          (total(p));
        writeFields     false;
        writeControl    timeStep;
        writeInterval   50;
        log             true;
    }
    //END lossIn

    lossOutZone
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        regionType      faceZone;
        name            lossOut;
        operation       weightedAverage;
        weightField     phi;
        fields          (total(p));
        writeFields     false;
        writeControl    timeStep;
        writeInterval   50;
        log             true;
    }

    cellVols
    {
        type            writeCellVolumes;
        libs            ("libfieldFunctionObjects.so");
        executeControl  writeTime;
        writeControl    writeTime;
        writeFields     true;
        log             false;
    }

    wallShear
    {
        type            wallShearStress;
        libs            ("libfieldFunctionObjects.so");
        executeControl  writeTime;
        writeControl    writeTime;
        log             false;
    }

    wallSample
    {
        type            surfaces;
        libs            ("libsampling.so");
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (wallShearStress);
        surfaces
        {
            lowerWall
            {
                type            patch;
                patches         (lowerWall);
                interpolate     false;
            }
            upperWall
            {
                type            patch;
                patches         (upperWall);
                interpolate     false;
            }
        }
    }
}

