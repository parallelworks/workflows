{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/openproject/pgdata/PG_VERSION",
    "leftover_patterns": [
      "docker logs -f openproject_",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "containers": "sudo docker ps -aq --filter name=openproject_ | wc -l"
    }
  },
  "resource": "pw://alvaro/gcptest",
  "cluster": {
    "scheduler": false
  },
  "service": {},
  "oidc": {}
}
