{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/openproject/.secret_key_base",
    "leftover_patterns": [
      "docker logs -f openproject_",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "containers": "sudo docker ps -aq --filter name=openproject_ | wc -l"
    },
    "secrets": {
      "oidc.client_secret": "OPENPROJECT_TEST_OIDC_CLIENT_SECRET"
    }
  },
  "resource": "pw://alvaro/gcptest",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "container_runtime": "openproject-docker",
    "subdomain": "openproject-alvaro"
  },
  "oidc": {
    "client_id": "pwapp_254b29d69085165ecabd10ceeab31a88"
  }
}
