{
  "_test": {
    "timeout_s": 900,
    "expect": "error",
    "warm_marker": "${HOME}/postgres/pgdata/PG_VERSION",
    "leftover_patterns": [
      "pw endpoints run",
      "docker compose",
      "/usr/bin/pgweb",
      "postgres: checkpointer"
    ],
    "leftover_commands": {
      "docker_containers": "(docker ps -aq --filter name=postgres_ 2>/dev/null || sudo -n docker ps -aq --filter name=postgres_ 2>/dev/null || echo ERR) | wc -l"
    }
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": false
  },
  "service": {
    "user": "postgres",
    "password": "not-the-password-the-data-directory-was-created-with",
    "db": "postgres",
    "port": 5432,
    "data_dir": "${HOME}/postgres",
    "image": "postgres:18"
  }
}
