{
  "_test": {
    "timeout_s": 900,
    "leftover_patterns": [
      "pw endpoints run",
      "probe serve"
    ]
  },
  "resource": "pw://labcluster",
  "tests": {
    "repo": "https://github.com/parallelworks/probe-tests-activate-parallel-works.git",
    "branch": "main",
    "directory": "tests"
  },
  "results": {
    "location": "local",
    "directory": "${HOME}/pw/probe/results"
  }
}
