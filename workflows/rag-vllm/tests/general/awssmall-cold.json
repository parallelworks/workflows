{
  "_test": {
    "timeout_s": 2400,
    "http_expect": [
      200,
      302,
      307,
      401,
      404
    ],
    "warm_marker": [
      "${HOME}/pw/software/containers/vllm.sif",
      "${HOME}/pw/models/Qwen2.5-0.5B-Instruct/config.json"
    ],
    "leftover_patterns": [
      "vllm.entrypoints",
      "pw endpoints"
    ]
  },
  "runtype": "vllm",
  "cluster": {
    "resource": "pw://alvaro/awssmall",
    "scheduler": false
  },
  "model": {
    "source": "huggingface",
    "hf_model_id": "Qwen/Qwen2.5-0.5B-Instruct",
    "cache_dir": "~/pw/models"
  },
  "vllm": {
    "num_gpus": "1",
    "gpu_memory": "0.70",
    "max_model_len": "4096",
    "dtype": "float16",
    "attention_backend": "TRITON_ATTN",
    "extra_args": "--trust_remote_code"
  },
  "service": {
    "parent_install_dir": "${HOME}/pw/software",
    "container_uri": "ghcr.io/parallelworks/vllm:v1.0"
  }
}
