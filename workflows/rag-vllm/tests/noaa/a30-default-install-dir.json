{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": [
      "${HOME}/pw/software/containers/vllm.sif",
      "${HOME}/pw/software/models/Qwen2.5-0.5B-Instruct/config.json"
    ],
    "leftover_patterns": [
      "vllm.entrypoints",
      "pw endpoints"
    ]
  },
  "runtype": "vllm",
  "resource": "pw://alvaro/a30gpuserver",
  "cluster": {
    "scheduler": false
  },
  "model": {
    "source": "huggingface",
    "hf_model_id": "Qwen/Qwen2.5-0.5B-Instruct"
  },
  "vllm": {
    "num_gpus": "1",
    "gpu_memory": "0.20",
    "max_model_len": "4096",
    "dtype": "float16",
    "attention_backend": "TRITON_ATTN",
    "extra_args": "--trust_remote_code"
  },
  "service": {
    "container_uri": "ghcr.io/parallelworks/vllm:v1.0"
  }
}
