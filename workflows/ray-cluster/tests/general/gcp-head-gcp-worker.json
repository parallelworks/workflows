{
  "_test": {
    "timeout_s": 2400,
    "ready_job": "complete",
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "warm_marker": "${HOME}/pw/software/ray-2.40.0/bin/python",
    "leftover_patterns": [
      "pw endpoints run",
      "gcs_server",
      "raylet",
      "uvicorn dashboard:app",
      "start_ray_head.sh",
      "dispatch_workers.sh"
    ]
  },
  "head": {
    "resource": "pw://alvaro/gcpsmall"
  },
  "workers": [
    {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": true,
      "slurm": {
        "partition": "compute",
        "nodes": 1,
        "gres": "",
        "time": "00:30:00",
        "scheduler_directives": ""
      }
    }
  ],
  "ray_settings": {
    "ray_version": "2.40.0"
  },
  "workload_settings": {
    "workload_type": "benchmark",
    "num_tasks": "100",
    "matrix_size": "200"
  }
}
