{
  "_test": {
    "timeout_s": 1500,
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "leftover_patterns": [
      "pw endpoints run",
      "ray_worker_remote",
      "slurm_worker.out",
      "gcs_server",
      "raylet"
    ]
  },
  "head": {
    "resource": "workspace"
  },
  "workers": [
    {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": true,
      "slurm": {
        "nodes": 1,
        "gres": "",
        "time": "01:00:00",
        "scheduler_directives": ""
      }
    }
  ]
}
