{
  "_test": {
    "timeout_s": 600,
    "endpoint": false,
    "ready_job": "wait_for_scheduler",
    "expect": "error",
    "scheduler": true,
    "leftover_patterns": [
      "SCREEN",
      "scheduler.sh",
      "usercontainer",
      "logs.out"
    ],
    "leftover_commands": {
