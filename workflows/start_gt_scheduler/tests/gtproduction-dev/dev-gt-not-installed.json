      "license-ports": "ss -tln | grep -c -E ':(27032|27812) '",
      "reverse-tunnel": "ss -tln | grep -c ':2222 '"
    }
  },
  "resource": "pw://gtproduction/dev",
  "gt": {
    "version": "v2019"
  }
}
